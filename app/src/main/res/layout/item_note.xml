<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/noteItemContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    android:padding="14dp"
    android:minHeight="64dp"
    android:background="@drawable/bg_note_item"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/tvNoteTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_toStartOf="@id/ivFavorite"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:text="Titre"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/tvNoteDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvNoteTitle"
        android:layout_alignParentStart="true"
        android:layout_toStartOf="@id/ivFavorite"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:text="01 Juin 2026"
        android:layout_marginTop="2dp" />

    <ImageView
        android:id="@+id/ivFavorite"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:src="@drawable/ic_star_filled"
        android:visibility="gone"
        android:contentDescription="Favori" />

</RelativeLayout>